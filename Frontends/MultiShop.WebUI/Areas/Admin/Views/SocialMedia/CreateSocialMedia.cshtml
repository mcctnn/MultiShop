@model CreateSocialMediaDto
@{
    ViewData["Title"] = "CreateSocialMedia";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">

                <div class="bs-example" data-example-id="bordered-table">
                    <form method="post">
                        <label>Sosyal medya adı</label>
                        <input type="text" class="form-control" asp-for="SocialMediaName" />
                        <br />
                        <label>Sosyal medya link</label>
                        <input type="text" class="form-control" asp-for="Link" />
                        <br />
                        <label>Sosyal medya ikon</label>
                        <input type="text" class="form-control" asp-for="Icon" />
                        <br />                       
                        <button class="btn btn-primary">Sosyal medyayı ekle</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

