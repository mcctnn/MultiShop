@model CreateAboutDto
@{
    ViewData["Title"] = "CreateAbout";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">

                <div class="bs-example" data-example-id="bordered-table">
                    <form method="post">
                        <label>Hakkımda açıklaması</label>
                        <input type="text" class="form-control" asp-for="Description" />
                        <br />
                        <label>Hakkımda Adresi</label>
                        <input type="text" class="form-control" asp-for="Address" />
                        <br />
                        <label>Hakkımda maili</label>
                        <input type="text" class="form-control" asp-for="Email" />
                        <br />
                        <label>Hakkımda telefon</label>
                        <input type="text" class="form-control" asp-for="Phone" />
                        <br />
                        <button class="btn btn-primary">Hakkımda alanı ekle</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

